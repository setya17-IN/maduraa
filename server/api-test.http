@baseUrl = http://localhost:5000/api/v1

# Kredensial dibaca dari server/.env (tidak ikut ter-commit)
@ownerEmail = {{$dotenv OWNER_EMAIL}}
@ownerPassword = {{$dotenv OWNER_PASSWORD}}
@cashierEmail = {{$dotenv CASHIER_EMAIL}}
@cashierPassword = {{$dotenv CASHIER_PASSWORD}}

# Urutan pakai: jalankan "Login owner" dan "Login cashier" dulu,
# baru request lainnya. Jalankan bagian LOGOUT (7) dan RATE LIMIT (8) paling akhir.
#
# Bagian 5B (upload gambar) membutuhkan file uji di folder ./test-assets/
# (relatif terhadap lokasi file .http ini):
#   kecil.jpg, kecil.png  -> gambar kecil (< 100 KB)
#   besar.jpg             -> gambar lebih dari 2 MB
#   dokumen.pdf           -> PDF apa saja
#   palsu.jpg             -> file teks biasa yang diganti nama menjadi .jpg
# Jangan commit folder test-assets/.

### ==========================================
### 1. LOGIN BERHASIL
### ==========================================

### Login owner -> 200, ada token, role = owner
# @name loginOwner
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{ownerEmail}}",
  "password": "{{ownerPassword}}"
}

### Login cashier -> 200, ada token, role = cashier
# @name loginCashier
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{cashierEmail}}",
  "password": "{{cashierPassword}}"
}
###
@ownerToken = {{loginOwner.response.body.$.token}}
@cashierToken = {{loginCashier.response.body.$.token}}

### ==========================================
### 2. LOGIN GAGAL & REGISTER DIHAPUS
### ==========================================

### Password salah -> 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{ownerEmail}}",
  "password": "PasswordSalah123"
}

### Email tidak terdaftar -> 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "tidakada@example.com",
  "password": "apapun123"
}

### Body kosong -> 400
POST {{baseUrl}}/auth/login
Content-Type: application/json

{}

### Field password hilang -> 400
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{ownerEmail}}"
}

### Register harus 404 (atau 405)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "email": "baru@example.com",
  "password": "Password123!"
}

### ==========================================
### 3. AKSES TERPROTEKSI (AUTH)
### ==========================================

### Tanpa token -> 401
GET {{baseUrl}}/auth/me

### Token invalid -> 401
GET {{baseUrl}}/auth/me
Authorization: Bearer token.ngawur.123

### Token owner valid -> 200, role = owner
GET {{baseUrl}}/auth/me
Authorization: Bearer {{ownerToken}}

### Token cashier valid -> 200, role = cashier
GET {{baseUrl}}/auth/me
Authorization: Bearer {{cashierToken}}

### ==========================================
### 4. KATEGORI
### ==========================================

### Lihat kategori (owner) -> 200
GET {{baseUrl}}/categories
Authorization: Bearer {{ownerToken}}

### Lihat kategori (cashier) -> 200
GET {{baseUrl}}/categories
Authorization: Bearer {{cashierToken}}

### Buat kategori (owner) -> 201
# Sesuaikan jika aturan role di kode Anda berbeda
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "name": "Makanan"
}

### Buat kategori (cashier) -> 403 jika khusus owner
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{cashierToken}}

{
  "name": "Minuman"
}

### ==========================================
### 5. PRODUK - CRUD (#46)
### ==========================================

### Lihat produk (owner) -> 200
GET {{baseUrl}}/products
Authorization: Bearer {{ownerToken}}

### Lihat produk (cashier) -> 200
GET {{baseUrl}}/products
Authorization: Bearer {{cashierToken}}

### Lihat produk tanpa token -> 401
GET {{baseUrl}}/products

### Buat produk (owner) -> 201, simpan id-nya
# Jika field wajib lain diminta (mis. kategori/stok), sesuaikan body ini.
# @name createProduct
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "name": "Produk Uji HTTP",
  "selling_price": 15000
}
###
@productId = {{createProduct.response.body.$.data.id}}

### Buat produk, harga negatif -> 400
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "name": "Produk Salah",
  "selling_price": -1
}

### Buat produk, harga string -> 400
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "name": "Produk Salah",
  "selling_price": "abc"
}

### Buat produk, harga null -> 400
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "name": "Produk Salah",
  "selling_price": null
}

### Buat produk (cashier) -> 403
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{cashierToken}}

{
  "name": "Produk Cashier",
  "selling_price": 1000
}

### Detail produk -> 200
GET {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{ownerToken}}

### Detail produk (cashier) -> 200
GET {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{cashierToken}}

### Detail produk, UUID tidak valid -> 400
GET {{baseUrl}}/products/bukan-uuid
Authorization: Bearer {{ownerToken}}

### Detail produk, UUID tidak ada -> 404
GET {{baseUrl}}/products/00000000-0000-4000-8000-000000000000
Authorization: Bearer {{ownerToken}}

### Ubah produk (owner) -> 200
PUT {{baseUrl}}/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "selling_price": 16000
}

### Ubah produk, body kosong -> 400
PUT {{baseUrl}}/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{}

### Ubah produk, harga tidak valid -> 400
PUT {{baseUrl}}/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "selling_price": -500
}

### Ubah produk, UUID tidak ada -> 404
PUT {{baseUrl}}/products/00000000-0000-4000-8000-000000000000
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "selling_price": 16000
}

### Ubah produk (cashier) -> 403
PUT {{baseUrl}}/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{cashierToken}}

{
  "selling_price": 17000
}

### ==========================================
### 5B. PRODUK - UPLOAD GAMBAR (#47)
### ==========================================

### Upload JPG valid (owner) -> 200, image_url terisi
# Buka image_url di browser dan cek file di Supabase Storage > product-images
POST {{baseUrl}}/products/{{productId}}/image
Authorization: Bearer {{ownerToken}}
Content-Type: multipart/form-data; boundary=----Maduraa

------Maduraa
Content-Disposition: form-data; name="image"; filename="kecil.jpg"
Content-Type: image/jpeg

< ./test-assets/kecil.jpg
------Maduraa--

### Upload ulang PNG (owner) -> 200, file lama harus hilang dari bucket
POST {{baseUrl}}/products/{{productId}}/image
Authorization: Bearer {{ownerToken}}
Content-Type: multipart/form-data; boundary=----Maduraa

------Maduraa
Content-Disposition: form-data; name="image"; filename="kecil.png"
Content-Type: image/png

< ./test-assets/kecil.png
------Maduraa--

### Detail produk setelah upload -> 200, image_url terisi
GET {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{ownerToken}}

### File lebih dari 2 MB -> 413
POST {{baseUrl}}/products/{{productId}}/image
Authorization: Bearer {{ownerToken}}
Content-Type: multipart/form-data; boundary=----Maduraa

------Maduraa
Content-Disposition: form-data; name="image"; filename="besar.jpg"
Content-Type: image/jpeg

< ./test-assets/besar.jpg
------Maduraa--

### PDF -> 400
POST {{baseUrl}}/products/{{productId}}/image
Authorization: Bearer {{ownerToken}}
Content-Type: multipart/form-data; boundary=----Maduraa

------Maduraa
Content-Disposition: form-data; name="image"; filename="dokumen.pdf"
Content-Type: application/pdf

< ./test-assets/dokumen.pdf
------Maduraa--

### File teks bernama .jpg (magic bytes palsu) -> 400
POST {{baseUrl}}/products/{{productId}}/image
Authorization: Bearer {{ownerToken}}
Content-Type: multipart/form-data; boundary=----Maduraa

------Maduraa
Content-Disposition: form-data; name="image"; filename="palsu.jpg"
Content-Type: image/jpeg

< ./test-assets/palsu.jpg
------Maduraa--

### Tanpa file (field lain saja) -> 400
POST {{baseUrl}}/products/{{productId}}/image
Authorization: Bearer {{ownerToken}}
Content-Type: multipart/form-data; boundary=----Maduraa

------Maduraa
Content-Disposition: form-data; name="catatan"

halo
------Maduraa--

### Upload tanpa token -> 401
POST {{baseUrl}}/products/{{productId}}/image
Content-Type: multipart/form-data; boundary=----Maduraa

------Maduraa
Content-Disposition: form-data; name="image"; filename="kecil.jpg"
Content-Type: image/jpeg

< ./test-assets/kecil.jpg
------Maduraa--

### Upload (cashier) -> 403
POST {{baseUrl}}/products/{{productId}}/image
Authorization: Bearer {{cashierToken}}
Content-Type: multipart/form-data; boundary=----Maduraa

------Maduraa
Content-Disposition: form-data; name="image"; filename="kecil.jpg"
Content-Type: image/jpeg

< ./test-assets/kecil.jpg
------Maduraa--

### Upload, UUID tidak valid -> 400
POST {{baseUrl}}/products/bukan-uuid/image
Authorization: Bearer {{ownerToken}}
Content-Type: multipart/form-data; boundary=----Maduraa

------Maduraa
Content-Disposition: form-data; name="image"; filename="kecil.jpg"
Content-Type: image/jpeg

< ./test-assets/kecil.jpg
------Maduraa--

### Upload, produk tidak ada -> 404
POST {{baseUrl}}/products/00000000-0000-4000-8000-000000000000/image
Authorization: Bearer {{ownerToken}}
Content-Type: multipart/form-data; boundary=----Maduraa

------Maduraa
Content-Disposition: form-data; name="image"; filename="kecil.jpg"
Content-Type: image/jpeg

< ./test-assets/kecil.jpg
------Maduraa--

### ==========================================
### 5C. PRODUK - HAPUS PRODUK UJI
### ==========================================
# Setelah selesai, hapus juga file hasil tes di Supabase Storage > product-images.
# Menghapus produk TIDAK otomatis menghapus file gambarnya.

### Hapus produk (cashier) -> 403
DELETE {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{cashierToken}}

### Hapus produk (owner) -> 200
DELETE {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{ownerToken}}

### Detail setelah dihapus -> 404
GET {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{ownerToken}}

### Hapus produk yang sudah tidak ada -> 404
DELETE {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{ownerToken}}

### Hapus produk, UUID tidak valid -> 400
DELETE {{baseUrl}}/products/bukan-uuid
Authorization: Bearer {{ownerToken}}

### ==========================================
### 6. TRANSAKSI & DASHBOARD
### ==========================================

### Transaksi (owner) -> 200, semua transaksi
GET {{baseUrl}}/transactions
Authorization: Bearer {{ownerToken}}

### Transaksi (cashier) -> 200, semua transaksi (sesuai PR #39)
GET {{baseUrl}}/transactions
Authorization: Bearer {{cashierToken}}

### Dashboard (owner) -> 200
GET {{baseUrl}}/dashboard/summary
Authorization: Bearer {{ownerToken}}

### Dashboard (cashier) -> 403 jika khusus owner
GET {{baseUrl}}/dashboard/summary
Authorization: Bearer {{cashierToken}}

### ==========================================
### 7. LOGOUT & TOKEN DIREVOKASI (jalankan setelah bagian lain)
### ==========================================

### Logout cashier -> 200
# Sesuaikan path jika endpoint logout Anda berbeda
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{cashierToken}}

### Pakai token cashier yang sudah logout -> 401
GET {{baseUrl}}/auth/me
Authorization: Bearer {{cashierToken}}

### ==========================================
### 8. RATE LIMIT LOGIN (jalankan paling akhir)
### ==========================================
# Kirim request ini berkali-kali berturut-turut.
# Setelah batas terlewati, harus muncul 429.
# Setelah itu login bisa terblokir sementara; tunggu sebelum login lagi.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{ownerEmail}}",
  "password": "PasswordSalah123"
}
