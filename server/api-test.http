@baseUrl = http://localhost:5000/api/v1
@testEmail = userbaru.testing@gmail.com
@testPassword = TestPassword123!

### Register a test account (change the email if this account already exists).
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### Run login first, then send the protected request.
@token = {{login.response.body.token}}

GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### ==========================================
### TEST ENDPOINT KATEGORI (PRODUCT CATEGORIES)
### ==========================================

### Get All Categories
GET {{baseUrl}}/categories
Authorization: Bearer {{token}}

### Create Category
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Makanan"
}


### ==========================================
### TEST ENDPOINT PRODUK (PRODUCTS)
### ==========================================

### Get All Products
GET {{baseUrl}}/products
Authorization: Bearer {{token}}


### ==========================================
### TEST ENDPOINT TRANSAKSI & REPORT
### ==========================================

### Get Transactions
GET {{baseUrl}}/transactions
Authorization: Bearer {{token}}

### Get Dashboard Summary
GET {{baseUrl}}/dashboard/summary
Authorization: Bearer {{token}}
